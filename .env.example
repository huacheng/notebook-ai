# notebook-ai environment configuration
# Copy this file to .env and customize values before starting.

# Auth mode: 'token' (default) or 'password'
NB_AUTH_MODE=token

# Shared access token for auth-token mode (min 24 characters)
# Generate one with: openssl rand -hex 32
NB_AUTH_TOKEN=

# Root directory for project workspaces
# NB_WORKSPACES_ROOT=~/nb-workspaces

# v2 独立数据库路径（全新部署时指定，避免与旧版共享数据）
# NB_DB_PATH=~/.notebook-ai-v2/notebook.db

# Shared knowledge library path
# NB_WORKSPACES_LIBRARY=$NB_WORKSPACES_ROOT/.library

# Set to '1' to trust X-Forwarded-For header (behind reverse proxy)
# TRUST_PROXY=

# Comma-separated allowed origins for CSRF Origin check (mutate requests with cookie).
# Default: http://localhost:3003,http://localhost:4003
# NB_ALLOWED_ORIGINS=http://localhost:3003,http://localhost:4003

# Set to '1' only in tests to bypass the CSRF Origin check. Never set in production.
# NB_CSRF_DISABLED=
