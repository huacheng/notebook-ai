# notebook-ai environment configuration
# Copy this file to .env and customize values before starting.

# Auth mode: 'token' (default) or 'password'
NB_AUTH_MODE=token

# Shared access token for auth-token mode (min 24 characters)
# Generate one with: openssl rand -hex 32
NB_AUTH_TOKEN=

# Root directory for project workspaces
# NB_WORKSPACES_ROOT=~/nb-workspaces

# Shared knowledge library path
# NB_WORKSPACES_LIBRARY=$NB_WORKSPACES_ROOT/.library

# Set to '1' to trust X-Forwarded-For header (behind reverse proxy)
# TRUST_PROXY=
